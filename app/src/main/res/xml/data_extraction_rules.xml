<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Cloud backup / data extraction rules (Android 12+).
  ~ For a force-protection tool, sensitive threat history, learned baselines,
  ~ tower caches and preferences must NOT leave the device via cloud backup or
  ~ device-to-device transfer. We exclude the Room database and app preferences
  ~ from both paths. Only non-sensitive resources may transfer by default.
  -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="edge_sentinel.db" />
        <exclude domain="database" path="edge_sentinel.db-wal" />
        <exclude domain="database" path="edge_sentinel.db-shm" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="travel_exports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="edge_sentinel.db" />
        <exclude domain="database" path="edge_sentinel.db-wal" />
        <exclude domain="database" path="edge_sentinel.db-shm" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="travel_exports" />
    </device-transfer>
</data-extraction-rules>
