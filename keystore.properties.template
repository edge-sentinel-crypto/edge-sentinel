# Edge Sentinel release signing credentials (TEMPLATE)
#
# Copy this file to keystore.properties (which is gitignored) and fill in the
# values, OR export the equivalent EDGE_SENTINEL_* environment variables.
# NEVER commit real credentials. keystore.properties is in .gitignore.
#
# SECURITY: The previous release key (alias "edge-sentinel") had its password
# hardcoded in build.gradle.kts and must be treated as COMPROMISED. Rotate to a
# freshly generated keystore before any production/Play Store distribution.
#
storeFile=/absolute/path/to/rotated-release.jks
storePassword=CHANGE_ME
keyAlias=edge-sentinel-2026
keyPassword=CHANGE_ME
